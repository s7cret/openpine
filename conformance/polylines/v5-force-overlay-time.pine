indicator("Polylines", overlay=true)
var array<chart.point> corners = array.from(chart.point.from_time(0, 12), chart.point.from_time(150000, 42), chart.point.from_time(300000, 15))
var polyline region = polyline.new(corners, closed=true, xloc=xloc.bar_time, line_color=na, fill_color=#33669980, force_overlay=true)
