//@version=6
indicator("String format")
plot(str.format("{0} | {1,number,integer}", 1234.56789, 1234.6) == "1,234.568 | 1,235" ? 1.0 : 0.0)
plot(str.format("{0,number,currency} | {1,number,percent}", -1250.5, -0.125) == "-$1,250.50 | -13%" ? 1.0 : 0.0)
plot(str.format("{0,number,0.00} | {1,number,000.0#}", 2.5, 7.125) == "2.50 | 007.13" ? 1.0 : 0.0)
plot(str.format("{0,number,'$',###.0000}", 1234.56) == "$1,234.5600" ? 1.0 : 0.0)
