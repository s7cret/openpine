//@version=1
strategy("Lot entries",pyramiding=3,close_entries_rule="LIFO",default_qty_type=strategy.fixed,default_qty_value=1,initial_capital=1000,commission_value=1)

plot(strategy.position_size,title="Position")
plot(strategy.equity,title="Equity")
plot(strategy.position_avg_price,title="Entry price")
