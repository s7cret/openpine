//@version=4
strategy("Lot entries",pyramiding=3,close_entries_rule="ANY",default_qty_type=strategy.fixed,default_qty_value=1,initial_capital=1000,commission_value=1)
if bar_index==0
    strategy.entry("A",strategy.long,qty=2)
if bar_index==1
    strategy.entry("B",strategy.long,qty=3,stop=115)
    strategy.exit("PB","B",stop=80,limit=140,qty_percent=100)
if bar_index==2
    strategy.cancel("B")
    strategy.close("A")
plot(strategy.position_size,title="Position")
plot(strategy.equity,title="Equity")
plot(strategy.position_avg_price,title="Entry price")
