{
  "schema_version": "openpine.conformance.cases.1",
  "implementation_profile_id": "openpine.historical-bars.1",
  "oracle": {
    "kind": "independent_manual_expectations",
    "basis": "Own synthetic bars and manual recurrence: length 3 gives alpha=1/2; 10,20,30,40 yield 10,15,22.5,31.25. A second EMA yields 10,12.5,17.5,24.375. Length 1 copies each defined source. Initial na stays na; later na retains the previous EMA. Integer 3 promotes to float and remains 3. Expected values are not generated by OpenPine.",
    "external_pine_execution": false
  },
  "rule_refs": ["rule.binding", "rule.types", "rule.arguments.left_to_right", "rule.context.current", "rule.ema", "rule.ema.length", "rule.state.call_site_context", "rule.execution.skipped_call"],
  "assertion_refs": ["assertion.symbol.variable.close.value", "assertion.overload.ta.ema.source_length.signature", "assertion.overload.indicator.harness.signature", "assertion.overload.plot.harness.signature"],
  "cases": [
    {"case_id":"close","source":"close.pine","bars":"fixed.json","language_version":6,"expected":{"status":"executed","title":"Fixed close","shorttitle":"","overlay":false,"observation_count":4,"qualifiers":["series"],"outputs":[{"title":"close","type":"float","values":[10.0,20.0,30.0,40.0]}]}},
    {"case_id":"ema","source":"ema.pine","bars":"fixed.json","language_version":6,"expected":{"status":"executed","title":"EMA on fixed bars","shorttitle":"","overlay":false,"observation_count":4,"qualifiers":["series"],"outputs":[{"title":"ema","type":"float","values":[10.0,15.0,22.5,31.25]}]}},
    {"case_id":"call-sites","source":"call-sites.pine","bars":"fixed.json","language_version":6,"expected":{"status":"executed","title":"Independent calls","shorttitle":"","overlay":false,"observation_count":4,"qualifiers":["series","series","series"],"outputs":[{"title":"same","type":"float","values":[10.0,15.0,22.5,31.25]},{"title":"same","type":"float","values":[10.0,20.0,30.0,40.0]},{"title":"nested","type":"float","values":[10.0,12.5,17.5,24.375]}]}},
    {"case_id":"missing","source":"missing.pine","bars":"missing.json","language_version":6,"expected":{"status":"executed","title":"EMA skips missing source","shorttitle":"","overlay":false,"observation_count":6,"qualifiers":["series","series"],"outputs":[{"title":"close","type":"float","values":[null,10.0,null,20.0,30.0,null]},{"title":"ema","type":"float","values":[null,10.0,10.0,15.0,22.5,22.5]}]}},
    {"case_id":"constant","source":"constant.pine","bars":"fixed.json","language_version":6,"expected":{"status":"executed","title":"Integer source promotion","shorttitle":"","overlay":false,"observation_count":4,"qualifiers":["series"],"outputs":[{"title":"ema","type":"float","values":[3.0,3.0,3.0,3.0]}]}},
    {"case_id":"reject-zero","source":"reject-zero.pine","bars":"fixed.json","language_version":6,"expected":{"status":"rejected","category":"RUNTIME_ERROR","code":"EMA_LENGTH"}},
    {"case_id":"reject-negative","source":"reject-negative.pine","bars":"fixed.json","language_version":6,"expected":{"status":"rejected","category":"RUNTIME_ERROR","code":"EMA_LENGTH"}},
    {"case_id":"reject-float","source":"reject-float.pine","bars":"fixed.json","language_version":6,"expected":{"status":"rejected","category":"LANGUAGE_INVALID","code":"ARGUMENT_TYPE"}},
    {"case_id":"reject-bool","source":"reject-bool.pine","bars":"fixed.json","language_version":6,"expected":{"status":"rejected","category":"LANGUAGE_INVALID","code":"ARGUMENT_TYPE"}},
    {"case_id":"pine-v5","source":"pine-v5.pine","bars":"fixed.json","language_version":5,"expected":{"status":"rejected","category":"IMPLEMENTATION_MISSING","code":"LANGUAGE_PROFILE_UNIMPLEMENTED"}},
    {"case_id":"missing-bars","source":"ema.pine","language_version":6,"expected":{"status":"rejected","category":"INPUT_UNAVAILABLE","code":"BARS_REQUIRED"}}
