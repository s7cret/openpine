//@version=5
strategy("Order groups",pyramiding=0,close_entries_rule="ANY",default_qty_type=strategy.fixed,default_qty_value=1,initial_capital=1000,commission_value=1)
if bar_index==0
    strategy.order("A",strategy.long,qty=2,limit=95,oca_name="a",oca_type=strategy.oca.cancel)
    strategy.order("B",strategy.long,qty=3,limit=90,oca_name="b",oca_type=strategy.oca.reduce)
if bar_index==1
    strategy.cancel_all()
plot(strategy.position_size,title="Position")
plot(strategy.equity,title="Equity")
plot(strategy.position_avg_price,title="Entry price")
