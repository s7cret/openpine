//@version=2
strategy("Order groups",pyramiding=0,close_entries_rule="ANY",default_qty_type=strategy.fixed,default_qty_value=1,initial_capital=1000,commission_value=1)
if bar_index==0
    strategy.order("A",strategy.long,qty=2,limit=95,oca_name="entries",oca_type=strategy.oca.reduce)
    strategy.order("B",strategy.long,qty=5,stop=105,limit=103,oca_name="entries",oca_type=strategy.oca.reduce)
    strategy.exit("PA","A",limit=110,qty_percent=100,oca_name="profit")
    strategy.exit("PB","B",limit=120,qty_percent=100,oca_name="profit")
if bar_index==4
    strategy.close_all()
plot(strategy.position_size,title="Position")
plot(strategy.equity,title="Equity")
plot(strategy.position_avg_price,title="Entry price")
