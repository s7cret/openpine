//@version=6
indicator("Scalars")
s=close < 103 ? "bid=12.50 ask=13.75" : close < 106 ? "auction closed" : "ask=9.75"
pattern=close < 106 ? "[0-9]+[.][0-9]+" : "ask"
m=str.match(s,pattern)
plot(str.tonumber(m))
plot(m==(close < 103 ? "12.50" : close < 106 ? "" : "ask") ? 1 : 0)
plot(str.match(s,"\\d+")==(close < 103 ? "12" : close < 106 ? "" : "9") ? 1 : 0)
