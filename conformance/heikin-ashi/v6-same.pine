//@version=6
indicator("Compare market and Heikin Ashi candles")
ha = ticker.heikinashi(syminfo.tickerid)
plot(request.security(syminfo.tickerid, timeframe.period, close), "Market close")
plot(request.security(ha, timeframe.period, open), "HA open")
plot(request.security(ha, timeframe.period, high), "HA high")
plot(request.security(ha, timeframe.period, low), "HA low")
plot(request.security(ticker.heikinashi(syminfo.tickerid), timeframe.period, close), "HA close")
plot(request.security(ha, timeframe.period, volume), "HA volume")
