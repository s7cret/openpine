//@version=5
indicator("Tables", overlay=true)
var table panel = table.new(position.top_right, 3, 2, bgcolor=#223344)
var table spare = table.new(position.bottom_left, 1, 1)
var line upper = line.new(0, 10, 3, 30)
var line lower = line.new(0, 5, 3, 15)
var label tag = label.new(0, 10, "seed")
var box zone = box.new(0, 15, 3, 5)
var linefill shade = linefill.new(upper, lower, #883311)
var array<chart.point> points = array.from(chart.point.from_index(0, 5), chart.point.from_index(2, 15))
var polyline path = polyline.new(points)
if bar_index == 0
    table.merge_cells(panel, 0, 0, 1, 0)
    table.cell(panel, row=0, column=0, text="Header", width=20, tooltip="Tip")
    table.cell(panel, column=0, row=1, text="Transient")
    line.set_xy2(upper, 3, 25)
    replica = line.copy(upper)
    line.set_y2(replica, 50)
    line.delete(replica)
    label.set_text(tag, "tag")
    box.set_bgcolor(zone, #334455)
    linefill.set_color(shade, #22AA33)
if bar_index == 1
    table.clear(panel, start_row=1, start_column=0)
    table.cell_set_text(panel, 0, 0, close < 20 ? "Open" : "Confirmed")
    table.delete(spare)
    polyline.delete(path)
plot(line.get_price(linefill.get_line1(shade), 3), title="price")
