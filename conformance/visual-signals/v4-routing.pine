//@version=4
study("Signals","",true)
c=input(#12345680,type=input.color)
tc=close>20 ? #FFFFFFFF : #FFFF0080
plot(close)
bgcolor(close>20 ? c : na)
barcolor(close>20 ? c : na)
plotshape(close>20,"Entry",shape.triangleup,location.belowbar,c,0,1,"BUY",tc,size=size.small)
plotchar(close,"Price","*",location.absolute,c,0,-1,"",tc,size=size.small)
