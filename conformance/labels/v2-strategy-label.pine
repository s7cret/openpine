//@version=2
strategy("Signal labels", default_qty_type=strategy.fixed, initial_capital=1000, overlay=true)
if barstate.isconfirmed and bar_index == 0
    strategy.entry("L", strategy.long)
if barstate.isconfirmed and bar_index == 2
    strategy.close("L")
plot(strategy.equity)
var label status = na
if bar_index == 0
    status := label.new(bar_index, close, "Pending")
    label.new(bar_index, high, "Entry submitted")
if bar_index == 1
    label.set_xy(status, bar_index, close)
    label.set_text(status, "Open")
if bar_index == 2
    label.new(bar_index, high, "Exit submitted")
