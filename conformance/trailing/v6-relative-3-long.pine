//@version=6
strategy("Trailing exits",pyramiding=0,close_entries_rule="ANY",default_qty_type=strategy.fixed,default_qty_value=2,initial_capital=1000,commission_value=1)
if bar_index==0
    strategy.entry("L",strategy.long)
    strategy.exit("X","L",profit=3+2,loss=3+4)
plot(strategy.position_size,title="Position")
plot(strategy.equity,title="Equity")
plot(strategy.position_avg_price,title="Entry price")
