//@version=4
study("Channels")
[m,u,l] = kc(close,2,1)
[explicit,eu,el] = kc(useTrueRange=true,mult=1,series=close,length=2)
plot(round((m) * 1000000000) / 1000000000.0)
plot(round((u) * 1000000000) / 1000000000.0)
plot(round((eu) * 1000000000) / 1000000000.0)
plot(round((kcw(close,2,1,true)) * 1000000000) / 1000000000.0)
plot(round((kcw(close,2,1)) * 1000000000) / 1000000000.0)
plot(round((kcw(close,2,1,false)) * 1000000000) / 1000000000.0)
