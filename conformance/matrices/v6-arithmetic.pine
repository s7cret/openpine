//@version=6
indicator("Matrices")
var a=matrix.new<int>(2,3,1)
if bar_index==0
    a.set(0,1,2)
    a.set(0,2,3)
    a.set(1,0,4)
    a.set(1,1,5)
    a.set(1,2,6)
if bar_index==2
    a.set(1,2,8)
b=matrix.new<float>(2,3,0.5)
c=matrix.new<int>(3,1,0)
c.set(0,0,1)
c.set(2,0,-1)
v=array.from(1,0,-1)
p=matrix.mult(id2=c,id1=a)
q=a.mult(v)
s=a.sum(b)
s.set(0,0,10.)
plot(p.get(0,0))
plot(q.get(1))
plot(matrix.diff(id2=b,id1=a).get(1,2))
plot(a.sum(0.5).get(1,2))
plot(a.mult(2).get(0,0))
plot(a.diff(1).get(1,2))
plot(s.get(1,2))
