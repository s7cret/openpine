//@version=6
indicator("Matrices")
var a=matrix.new<int>(2,2,1)
var vals=array.new<int>()
var vecs=matrix.new<int>()
var delta=9
if bar_index==0
    a.set(0,0,2)
    a.set(1,1,2)
    vals:=matrix.eigenvalues(id=a)
    vecs:=a.eigenvectors()
if bar_index==2
    delta:=a.mult(vecs).get(1,1)-vals.get(1)*vecs.get(1,1)
plot(vals.get(0))
plot(vals.get(1))
plot(vecs.get(1,0))
plot(delta)
f=matrix.new<float>(2,2,0.)
f.set(0,0,2.)
f.set(0,1,4.)
f.set(1,0,6.)
f.set(1,1,8.)
roots=f.eigenvalues()
basis=matrix.eigenvectors(f)
plot(roots.get(0)<0 and roots.get(1)>10 ? 1 : 0)
plot(basis.columns())
