//@version=6
indicator("Matrices")
var a=matrix.new<int>(2,2,2)
var f=matrix.new<float>(2,2,2.)
if bar_index==0
    a.set(0,0,1)
    a.set(1,1,4)
    f.set(0,0,1.)
    f.set(1,1,4.)
if bar_index==2
    a.set(1,1,5)
    f.set(1,1,5.)
plot(a.det())
plot(matrix.rank(id=a))
plot(matrix.det(id=f))
plot(f.rank())
