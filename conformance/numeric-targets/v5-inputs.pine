//@version=5
indicator("Numeric targets")
identity(value) => str.replace_all(value,"never","unused")+str.tostring(math.round(0.0),"#")=="never" ? "2" : value
select(value) =>
    local=identity(value)
    if local==""
        ""
    else
        local
sym=input.symbol("")
tf=input.timeframe("",options=["","1","2"])
plot(request.security(select(sym),identity(tf),math.sqrt(math.pow(close,2))))
