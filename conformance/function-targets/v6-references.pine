//@version=6
indicator("Function targets")
pick(useChart,fallback) => useChart ? syminfo.tickerid : fallback
interval(useChart,fallback) =>
    if useChart
        timeframe.period
    else
        fallback
choose=input.bool(true)
sym=pick(choose,"TEST:A")
tf=interval(choose,"2")
plot(request.security(sym,tf,close))
