//@version=6
indicator("Time format")
plot(str.format_time(0, timezone="UTC-5") == "1969-12-31T19:00:00-0500" ? 1.0 : 0.0)
plot(str.format_time(0, timezone="UTC+05:30") == "1970-01-01T05:30:00+0530" ? 1.0 : 0.0)
plot(str.format_time(0, timezone="GMT+0100") == "1970-01-01T01:00:00+0100" ? 1.0 : 0.0)
