//@version=6
strategy("Pending entries",default_qty_type=strategy.fixed,default_qty_value=10,initial_capital=1000,commission_type=strategy.commission.percent,commission_value=0)
if bar_index==0
    strategy.entry("L",strategy.long,limit=95,oca_name="group")
plot(strategy.position_size,title="Position")
plot(strategy.equity,title="Equity")
