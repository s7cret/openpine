{"base_manifest_sha256":"531f85386978d805de3756d2d1c70d748a4cd392c0caad3c4173e8a9d9c6fa06","review":{"basis":"Pinned per-version wiki records, official documentation and an explicitly bounded execution model.","date":"2026-10-24","decisions":["No loops in v1. For/break/continue in v2-v6; while in v5-v6. V2-v4 frozen end bounds and the modern direct-var rule are explicit historical reconstructions.","For evaluates initial/end/positive-int step at entry, fixes direction from initial bounds, includes both ends and stops on a missing bound. V6 re-evaluates the end after each completed/continued iteration. Explicit counter writes and collection iteration are excluded.","Statement loops may end with assignments, calls or control. Value loops return their last completed tail; numeric missing is NA, v6 bool missing is false. Flat numeric/bool tuple tails are allowed; string/void values and control-only value tails are excluded.","Each written local var and stateful call chain is shared by iterations. Ordinary declarations initialize each reached iteration. History remains bar-aligned with final variable/expression values; changing a simple TA length through the counter is rejected.","The existing unconditional-global request profile is retained: loops may consume an already scheduled requested value but cannot introduce requests inside their body or requested expression.","All loops in a bar share fixed iteration and operation budgets. Cancellation is checked within execution. Only completed bars can be checkpointed or published; failed/cancelled evaluations are poisoned. No platform wall-clock equivalence is claimed."],"external_pine_execution":false,"sources":[{"finding":"For, break and continue were introduced in v2; positive step and automatic direction.","url":"https://www.tradingview.com/pine-script-docs/v3/language/expressions-declarations-and-statements/"},{"finding":"October 2021 introduced while with Pine v5.","url":"https://www.tradingview.com/pine-script-docs/release-notes/"},{"finding":"V6 evaluates the for end boundary before every iteration; v5 freezes it at entry.","url":"https://www.tradingview.com/pine-script-docs/migration-guides/to-pine-version-6/"},{"finding":"Loop scope, last completed return, nearest break/continue and first iteration of a direct var initializer.","url":"https://www.tradingview.com/pine-script-docs/language/loops/"}],"test_refs":["tests/test_loops.py","tests/test_loops_state.py","tests/test_loops_pipeline.py","conformance/loops/cases.json"]},"schema_version":"openpine.loop-spec.1","version_review_manifest_sha256":"019cb2a538398fce686c2475860106997959c32095001bb068b4b2c0158b8aca","versions":{"1":{"basis":"documented_absence","evidence":[],"policy":{"cancellation_interval":128,"checkpoint":"completed_bar_only","control":"nearest_loop_within_function","counter_writes":"forbidden_in_this_profile","direct_var_initializer":"first_iteration","for":false,"for_bounds":"inclusive_int","for_direction":"initial_bounds","for_final":"entry","for_initial_and_step":"entry","for_step":"positive_int","history":"bar_aligned_final_value","iterations_per_bar":100000,"missing_bool":"na","missing_numeric":"na","na_bound":"no_iteration","operations_per_bar":1000000,"result":"last_completed_tail","result_types":"numeric_bool_or_flat_numeric_bool_tuple","scope":"local","state":"written_call_chain_shared_by_iterations","while":false},"profile_id":"openpine.loops.v1.1"},"2":{"basis":"artifact_defined_with_explicit_reconstruction","evidence":[{"entry_id":"wiki:v2:keywords:break","source_record_sha256":"88000a3174c31cf16e3f95438458d07bd3eba8661b57aa54775914177c25c534"},{"entry_id":"wiki:v2:keywords:continue","source_record_sha256":"7bd83e17c8461774c56c23ab154528f5da0e74075a50ccef619d5ca3c53d69dd"},{"entry_id":"wiki:v2:keywords:for","source_record_sha256":"e2c88a371c3014824ef714a081e88b3ae2be2803906ffdad710562d145b86f8b"}],"policy":{"cancellation_interval":128,"checkpoint":"completed_bar_only","control":"nearest_loop_within_f