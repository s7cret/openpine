{"base_manifest_sha256":"531f85386978d805de3756d2d1c70d748a4cd392c0caad3c4173e8a9d9c6fa06","review":{"basis":"Relative exits and trailing use explicit per-lot historical rules: v1/v2 signatures and early parameter precedence are reconstructed; v5 absolute priority and v6 earliest directional level follow the pinned migration decision. OHLC activation/ratchet timing is a bounded model, not external execution equivalence.","date":"2026-10-25","decisions":["The pinned wiki supplies full v3-v6 parameter names; v1 has names only and v2 partial examples. Early signatures and precedence are explicitly reconstructed.","Each exact reserved target has its own entry price, effective levels, activation, extreme and stop. Pending targets bind only on their actual parent fill.","v6 selects the first directional level: nearer favorable profit/activation, nearer adverse loss, absolute on ties. v1-v5 absolute priority is explicit; only v5/v6 is established by the additional migration source.","Known open activation and ratchet precede crossings. Intrabar checks use the previous effective stop; a high/low update or intrabar activation becomes effective next bar. No synthetic tick path or retroactive trigger.","Nonnegative whole tick distances and offsets, positive aligned resolved levels. Missing tick metadata and incomplete trailing pairs fail closed.","Unchanged price configuration preserves surviving exact-target state on reissue, including quantity/OCA changes. Changed price configuration resets it. New targets start fresh.","Fixed and active trailing stops choose the more protective level, fixed on ties. Stop wins ambiguous stop/take. Each equal order/role/level/basis batch uses one fill and one fee.","Existing lot reservations, OCA and journal are shared. Effects use actual filled quantities before the next candidate; reductions retain surviving target state.","At most 16 brackets with 16 targets each. Checkpoint contains only current state. Prior broker profiles and state readers remain unchanged."],"external_pine_execution":false,"sources":[{"accessed":"2026-10-25","facts":{"units":"profit, loss and trail_points measure ticks from entry; limit, stop and trail_price are prices.","v5":"Absolute parameters override their related relative parameters.","v6":"Related absolute and relative levels are both evaluated; the expected first trigger is selected."},"kind":"reviewed_parameter_pair_facts","selected_facts_sha256":"c426bf7a39731dca5a662698535a734d40881e7f7184e417ac472089bd0de49a","url":"https://www.tradingview.com/pine-script-docs/migration-guides/to-pine-version-6/"}],"test_refs":["tests/test_trailing.py","tests/test_trailing_pipeline.py","conformance/trailing/cases.json"]},"schema_version":"openpine.trailing-spec.1","version_review_manifest_sha256":"019cb2a538398fce686c2475860106997959c32095001bb068b4b2c0158b8aca","versions":{"1":{"apis":[["strategy.exit","simulation.exit_extended",[["id","string","const",null],["from_entry","string","const",null],["stop","float","series",{"kind":"na"}],["limit","float","series",{"kind":"na"}],["qty","float","series",{"kind":"na"}],["qty_percent","float","series",100.0],["oca_name","string","const",""],["profit","float","series",{"kind":"na"}],["loss","float","series",{"kind":"na"}],["trail_price","float","series",{"kind":"na"}],["trail_points","float","series",{"kind":"na"}],["trail_offset","float","series",{"kind":"na"}],["when","bool","series",true]]]],"evidence":[{"entry_id":"wiki:v1:functions:strategy.exit","source_record_sha256":"262cd7c224c8dcf83cf91c2eabc7f8d9821621f716a7e11d8d7b9dc415c89a37"}],"policy":{"activation":"trail_price_or_entry_plus_signed_trail_points_requires_trail_offset","ambiguous":"stop_before_take_no_interpolated_tick_path","basis":"reconstructed_names_only","bounds":{"commands_per_bar":16,"protections":16,"states":256,"targets_per_protection":16},"distance":"nonnegative_whole_ticks_from_exact_target_entry_fill","external_execution_verified":false,"fills":"batch_same_order_role