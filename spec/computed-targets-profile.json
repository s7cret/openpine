{"decisions":["Extend existing versioned scalar language with a finite const/input target evaluator; no external equivalence claim.","input.symbol and input.timeframe functions are attested in v5/v6; the v4 input.symbol constant is not a callable API.","Admit existing arithmetic, comparisons, boolean operations, conditional strings and concatenation with immutable global dependencies.","Validate all branches; evaluate selected branches with shared versioned scalar semantics before data acquisition.","Explicit nonempty qualified symbols and canonical timeframes only; empty chart-relative defaults, display and interactive confirm are outside the slice.","Separate computed.prepared overloads reuse Typed IR .11; the previous prepared contracts, policies and immutable bundles are retained."],"schema_version":"openpine.computed-target-profile.1","source_lock_sha256":"08a4183d5f9505aac50a6a28164211d3ee94833d4f67af32d8849a630d1b941e","versions":{"1":{"evidence":[{"entry_id":"wiki:v1:functions:input","name":"input","source_record_sha256":"ad632100b3f5d0c3d62632918c9852119ef6e07b53445b586493485a9a72a979"},{"entry_id":"wiki:v1:functions:security","name":"security","source_record_sha256":"61dc7b5d0905fc6b57778e3ab2486d8ffcf1e005cef618723a1f215fed425deb"}],"policy":{"empty_target":"reject_explicit_context_required","evaluation":"versioned_scalar_lazy_conditional","external_equivalence":false,"inputs":[],"language_version":1,"max_depth":16,"max_nodes":128,"max_string":4096,"nodes":["literal","input","load","binary","unary","convert","conditional"],"profile_id":"openpine.computed-targets.1","qualifiers":["const","input"],"resolution":"before_data_io","validation":"all_branches"},"reference_sha256":"3a18f08b5c201c9f31216ee66bce1fdb235d52ba82a029c666cea507eadb8656"},"2":{"evidence":[{"entry_id":"wiki:v2:functions:input","name":"input","source_record_sha256":"5534d45fadb6fdf66d8d8add1226e1857cfe2382000daa4184d44c564210b319"},{"entry_id":"wiki:v2:functions:security","name":"security",