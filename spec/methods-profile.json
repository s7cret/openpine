{"evidence":{"1":[],"2":[],"3":[],"4":[],"5":[{"entry_id":"primary:v5:keywords:method:overload:0","source_record_sha256":"c40065492c85fe6742722a6e65af58569e0567f7246cc63ddb4022c6b5aa6085","sources":[{"label":"TradingView · v5","sha256":"d1a50bf8536f5bc1c7e911831ec1d1228fef67f525903e9b30dfd957237fe96c","url":"https://www.tradingview.com/pine-script-reference/v5/#kw_method"}]},{"entry_id":"wiki:v5:method-overload","source_record_sha256":"be7abffad6b5b9068c55d0540946a4e2881b7d3d46f776a5c5c7cc20232b003f","sources":[{"label":"TradingView · Methods","sha256":"cc31e3e84eb23e55116b42d174b53cde6c6e663d323774cd3d625b420ca7ec57","url":"https://www.tradingview.com/pine-script-docs/v5/language/methods#method-overloading"}]}],"6":[{"entry_id":"primary:v6:keywords:method:overload:0","source_record_sha256":"ab5309b67b472b9f417a629fa2a4de30a6d784ad304dfec42509c1147cc2545e","sources":[{"label":"TradingView · v6","sha256":"c83e9b34d2e1d16fb6b2aa1845c6f591465be836e66b3add18d0775088881a9f","url":"https://www.tradingview.com/pine-script-reference/v6/#kw_method"}]},{"entry_id":"wiki:v6:method-overload","source_record_sha256":"96051739f7d015fe0b732ebf5737ab0ecb637ef6f230f524a42615dd5cc7d9ea","sources":[{"label":"TradingView · Methods","sha256":"5de3c67a25e01429fb220ecf71c21f031555256ebc8114634b485ddf181f14a1","url":"https://www.tradingview.com/pine-script-docs/language/methods/#method-overloading"}]}]},"release":"pine-methods-20261030.1","review":{"decisions":["Methods are admitted for v5/v6; v1-v4 explicitly reject method declarations and instance calls.","First parameter is explicitly typed and required; only existing scalar/primitive array receiver types are admitted.","Receiver dispatch requires its exact underlying type; remaining arguments use the bounded versioned UDF header rules.","Match minimum int-to-float cost; one matching user method overrides an equally good builtin. Tied user methods are ambiguous.","The precise ranking and v5/v6 arity policy are pinned OpenPine interpretations; external execution equivalence remains unverified.","Legacy qualified namespaces are preserved; parenthesizing a receiver disambiguates a name shared with a namespace.","User methods use dot-only calls in this slice. Defaults and qualifier inference retain existing bounded UDF policies.","Receiver is bound once before explicit arguments, closed defaults last. Existing UserCallIR/ArrayIR perform execution.","Typed IR .13 distinguishes method metadata from ordinary same-name functions. Private request graphs may retain one selected method.","No additional heap or runtime dispatch. State, rollback and checkpoint ownership remain tied to written call chains."],"external_execution_verified":false,"primary_sources":["https://www.tradingview.com/pine-script-docs/v5/release-notes/#february-2023","https://www.tradingview.com/pine-script-docs/v5/language/methods/","https://www.tradingview.com/pine-script-docs/language/methods/"],"test_refs":["tests/test_methods.py","conformance/methods/cases.json"]},"schema_version":"openpine.methods-spec.1","source_lock_sha256":"08a4183d5f9505aac50a6a28164211d3ee94833d4f67af32d8849a630d1b941e","versions":{"1":{"policy":{"available":false,"builtins":["size","get","set","push","pop","shift","unshift","clear","copy","sum","avg","min","max"],"evaluation":"receiver_once_then_explicit_arguments_in_source_order_then_closed_defaults","external_execution_verified":false,"frozen_targets":"existing_numeric_scalar_function_profile_unchanged_purity_budgets","language_version":1,"namespaces":"legacy_qualified_namespaces_preserved_parenthesized_receiver_disambiguates","overloads":"existing_versioned_header_policy","receiver":"explicit_typed_required_first_parameter_exact_underlying_type","receivers":["int","float","bool","string","array.int","array.float","array.bool","array.string"],"selection":"minimum_numeric_widenings_user_overrides_builtin_tie_ambiguous_user_ties_fail","state":"existing_written_call_chain","syntax":"dot_calls_including_history_a