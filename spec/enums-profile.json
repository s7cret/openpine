{"release":"pine-enums-20261031.1","review":{"decisions":["Nominal member tokens cannot be implicitly converted to strings or numbers. str.tostring returns the declared title.","Pin the v5 manual simple member qualifier separately from the v6 const member qualifier; external behavior remains unverified.","The v5 reference calls input.enum defval const enum, while the v5 manual describes simple enum members. This profile accepts only direct member syntax as defval and records the qualifier discrepancy, without claiming external equivalence.","Enum values are scalars in fields and array slots, with no new heap references or GC edges.","Titles and input presentation are limited to literals, as in the existing input profile."],"external_execution_verified":false,"primary_sources":["https://www.tradingview.com/pine-script-docs/v5/language/enums/","https://www.tradingview.com/pine-script-docs/language/enums/","https://www.tradingview.com/pine-script-docs/v5/language/type-system/","https://www.tradingview.com/pine-script-docs/language/type-system/","https://www.tradingview.com/pine-script-reference/v5/#fun_input.enum"]},"schema_version":"openpine.enums-spec.1","source_lock_sha256":"08a4183d5f9505aac50a6a28164211d3ee94833d4f67af32d8849a630d1b941e","versions":{"1":{"policy":{"available":false,"containers":["flat_udt_fields","arrays"],"excluded":["libraries","maps","matrices","enum_dependent_requests","enum_tuples"],"external_execution_verified":false,"identity":"global_declaration_span_and_member_count_nominal","input":"input.enum_frozen_member_selection","language_version":1,"max_members":64,"max_types":32,"member_qualifier":null,"members":"closed_type_and_member_index_scalar_token","operations":["assignment","na","equality","inequality","conditional","switch","history","str.tostring"],"profile_id":null,"title_qualifier":"existing_tostring_series_if_series_otherwise_simple","titles":"literal_string_or_field_name_unique_across_other_member_names_and_titles","v5_namespace_sha