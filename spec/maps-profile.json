s:overload:0","parameters":[{"default_claim":{"evidence_sha256":"37517e5f3dc66819f61f5a7bb8ace1921282415f10551d2defa5c3eb0985b570","spellings":[],"state":"not_documented"},"name":"id","parameter_id":"parameter.overload.entry.primary:v6:methods:map.values:overload:0.id","requiredness_claim":"required","type_spellings":["map<>"]}],"result_type_spellings":["array<type>"],"source_record_sha256":"b386f1eb5a7866a0b5a338e2536aca155db272e9a427594946baa0152a9aab65","sources":[{"label":"TradingView · v6","sha256":"c83e9b34d2e1d16fb6b2aa1845c6f591465be836e66b3add18d0775088881a9f","url":"https://www.tradingview.com/pine-script-reference/v6/#fun_map.values"}]}]},"release":"pine-maps-20261101.1","review":{"decisions":["Maps and methods require v5/v6. V1-v4 receive explicit MAP_VERSION diagnostics.","Keys are existing scalar or nominal enum types; values add flat UDT. No color, graphics, nested collections or reference fields.","Map.put returns the previous value or typed missing; get/remove of absent key do likewise. Missing bool results are false in v6.","Typed na keys share one canonical missing key. Finite floating keys use numeric equality, including equal signed zero. This is an explicit bounded interpretation of sparse reference records.","Existing keys retain insertion position and original key spelling when replaced; remove then reinsert appends.","For-in snapshots keys at entry, reads the current value, and yields missing for a removed key; new keys are not visited. Mutation during traversal is an explicit OpenPine interpretation.","Shared map-to-flat-record heap edges, shallow copies, COW previews, field-level varip and two physical cells per pair. Lookup index storage is included in the memory ledger.","Mutations stage the complete map; cost/scratch grow with its size. Work/storage/cancellation failures do not publish partial slots or a new ID. Existing global limits are preserved.","Map programs use typed-ir.17/runtime-state.10/array-heap.3; previous program formats remain. Imported Wiki bundles/profiles are unchanged."],"external_execution_verified":false,"primary_sources":["https://www.tradingview.com/pine-script-docs/v5/language/maps/","https://www.tradingview.com/pine-script-docs/language/maps/"],"test_refs":["tests/test_maps.py","conformance/maps/cases.json"]},"schema_version":"openpine.maps-spec.1","source_lock_sha256":"08a4183d5f9505aac50a6a28164211d3ee94833d4f67af32d8849a630d1b941e","versions":{"1":{"policy":{"available":false,"checkpoint":"typed-ir.17;runtime-state.10;array-heap.3;legacy_programs_unchanged","checkpoint_udt_values":"packed_object_ids;keys_and_order_preserved","copies":"independent_container;shallow_flat_udt_values","excluded":["color","graphics","nested_collections","reference_udt_fields","map_requests","map_tuple_results"],"external_execution_verified":false,"float_keys":"finite_numeric_equality;negative_zero_equals_zero","iteration":"two_targets_key_value;key_snapshot_at_entry;current_value_or_missing_if_removed","keys":["int","float","bool","string","enum"],"language_version":1,"limits_increased":false,"max_pairs":50000,"methods":false,"missing_key":"na;bool_v6_false","missing_keys":"typed_na_canonical_key;bool_v6_na_forbidden","mutation":"stage_entire_map;preflight_work_scratch_storage_and_cancel;atomic_publication","operations":[],"order":"insertion;overwrite_retains_position;remove_reinsert_appends","profile_id":null,"put_result":"previous_value_or_missing","storage":"shared_reference_heap;two_physical_cells_per_pair;acyclic_map_to_flat_record;lookup_index_accounted","values":["int","float","bool","string","enum","flat_udt"]},"reference_sha256":"3a18f08b5c201c9f31216ee66bce1fdb235d52ba82a029c666cea507eadb8656"},"2":{"policy":{"available":false,"checkpoint":"typed-ir.17;runtime-state.10;array-heap.3;legacy_programs_unchanged","checkpoint_udt_values":"packed_object_ids;keys_and_order_preserved","copies":"independent_container;shallow_flat_udt_values","excluded":["color","graphics","nested_collections