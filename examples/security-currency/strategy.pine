//@version=6
strategy("Cross-currency entry",default_qty_type=strategy.fixed,initial_capital=1000)
signal=request.security("TEST:A","1",close,currency=syminfo.currency)
plot(signal,"EUR")
plot(request.security("TEST:A","1",ta.ema(close,3),currency=currency.EUR),"EMA EUR")
plot(request.security("TEST:A","1",close),"USD")
if signal > 100 and signal[1] <= 100
    strategy.entry("Converted signal",strategy.long,qty=1)
