//@version=6
strategy("protective", default_qty_type=strategy.fixed, initial_capital=1000)
stopPrice = input.float(95.0, title="Stop")
limitPrice = input.float(110.0, title="Take profit")
if bar_index == 0
    strategy.entry("L", strategy.long)
    strategy.exit("X", "L", stop=stopPrice, limit=limitPrice)
plot(strategy.equity, title="Equity")
