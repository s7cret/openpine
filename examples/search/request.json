{
  "name": "Finite parameter search",
  "timeout_seconds": 60,
  "method": "grid",
  "budget": 3,
  "seed": 42,
  "space": {"n": {"min": 1, "max": 3, "step": 1}},
  "objective": {"metric": "output_mean", "output_index": 0, "direction": "maximize"},
  "windows": {
    "selection": {"warmup_start_ms": 0, "score_start_ms": 60000, "end_ms": 240000},
    "holdout": {"warmup_start_ms": 0, "score_start_ms": 240000, "end_ms": 360000}
  }
}
