//@version=1
strategy("Lot entries",pyramiding=3,close_entries_rule="FIFO",default_qty_type=strategy.fixed,default_qty_value=1,initial_capital=1000,commission_value=1)
part=input(2,title="Partial quantity",minval=1,maxval=2)
if bar_index%6==0
    strategy.entry("A",true,qty=2)
if bar_index%6==1
    strategy.entry("B",true,qty=3)
if bar_index%6==2
    strategy.close("B",qty=part)
if bar_index%6==3
    strategy.close("A")
    strategy.close("B")
plot(strategy.position_size,title="Position")
plot(strategy.equity,title="Equity")
plot(strategy.position_avg_price,title="Entry price")
