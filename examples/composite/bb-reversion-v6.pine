//@version=6
strategy("bb-reversion v6",default_qty_type=strategy.fixed,default_qty_value=1,initial_capital=1000,commission_value=0.1)
// Artifact-defined historical model; fixed protection uses signal-close prices.
atrLength=input.int(5,title="ATR length",minval=1,maxval=20)
risk=input.float(1.5,title="Stop ATR",minval=0.5,maxval=5.0)
higherLength=input.int(3,title="Higher length",minval=1,maxval=20)
length=input.int(8,title="Band length",minval=2,maxval=40)
mult=input.float(0.8,title="Band multiplier",minval=0.2,maxval=3.0)
bands(x,n,k) => ta.bb(x,n,k)
[middle,upper,lower]=bands(close,length,mult)
[higherMiddle,higherUpper,higherLower]=request.security("TEST:TECHNICAL","4",ta.bb(close,higherLength,mult))
volatility=ta.atr(atrLength)
enter=ta.crossunder(close,lower)
leave=ta.crossover(close,middle)
if strategy.position_size==0 and enter and close<higherMiddle and not na(volatility)
    strategy.entry("L",strategy.long)
    strategy.exit("X","L",stop=close-volatility*risk,limit=middle)
if strategy.position_size>0 and leave
    strategy.close("L")
plot(middle,title="Basis")
plot(upper,title="Upper")
plot(lower,title="Lower")
plot(volatility,title="ATR")
plot(strategy.equity,title="Equity")
