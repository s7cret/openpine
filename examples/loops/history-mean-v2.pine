//@version=2
strategy("history-mean v2",default_qty_type=strategy.fixed,default_qty_value=1,initial_capital=1000,commission_value=0.1)
// Bounded artifact-defined model; no external equivalence claim.
length=input(6,title="Window",minval=1,maxval=40)
mean(src,n) =>
    total = 0.0
    count = 0
    for i = 0 to n - 1
        if i > bar_index
            break
        if na(src[i])
            continue
        total := total + src[i]
        count := count + 1
    total / count
basis = mean(close,length)
higher = security("TEST:TECHNICAL","4",close)
if strategy.position_size == 0 and close > basis and close >= higher
    strategy.entry("L",strategy.long)
if strategy.position_size > 0 and (close < basis or bar_index % 16 == 15)
    strategy.close("L")
plot(basis,title="Loop mean")
plot(higher,title="Higher close")
plot(strategy.equity,title="Equity")
