//@version=6
strategy("Settlement",default_qty_type=strategy.fixed,default_qty_value=4,initial_capital=1000,commission_type=strategy.commission.percent,commission_value=1)
if bar_index==0
    strategy.entry("L",strategy.long,qty=4)
if bar_index==1
    strategy.close("L",qty=2)
if bar_index==2
    strategy.close("L")
plot(strategy.position_size)
