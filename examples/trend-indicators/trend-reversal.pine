//@version=6
indicator("Trend reversal", overlay=true)
factor = bar_index == 3 ? 1.0 : 0.5
[trendLine, direction] = ta.supertrend(factor, 1)
[_, _, adx] = ta.dmi(1, 1)
stopLine = ta.sar(0.25, 0.25, 0.5)
reversal = not na(trendLine[1]) and direction != direction[1] and adx >= 25
plot(trendLine, "Supertrend")
plot(stopLine, "Parabolic SAR")
plot(adx, "ADX", display=display.none)
alertcondition(reversal, "Trend reversal", 'Trend reversed, ADX {{plot("ADX")}}')
