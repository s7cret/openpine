//@version=6
strategy("Observed oca",default_qty_type=strategy.fixed,default_qty_value=1,initial_capital=1000,commission_value=0)
if bar_index==0
    strategy.entry("L",strategy.long,limit=95,oca_name="choice",oca_type=strategy.oca.cancel)
    strategy.entry("H",strategy.long,stop=105,oca_name="choice",oca_type=strategy.oca.cancel)
    strategy.exit("X","L",limit=110)
plot(strategy.equity)
plot(strategy.position_size)
