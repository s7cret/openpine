//@version=4
strategy("Array weighted-mean",default_qty_type=strategy.fixed,initial_capital=1000)
length = input(6, title="Window", minval=1, maxval=1000)
var window = array.new_float(0)
alias = window
array.push(alias, close)
if array.size(window) > length
    array.shift(window)
total = 0.0
weights = 0
for index = 0 to array.size(window) - 1
    value = array.get(window, index)
    total := total + value * (index + 1)
    weights := weights + index + 1
basis = total / weights
higher = security("TEST:TECHNICAL", "4", close)
if strategy.position_size == 0 and close > basis and close >= higher
    strategy.entry("L", strategy.long)
if strategy.position_size > 0 and (close < basis or bar_index % 16 == 15)
    strategy.close("L")
plot(basis, title="Array filter")
plot(higher, title="Higher close")
plot(strategy.equity, title="Equity")
