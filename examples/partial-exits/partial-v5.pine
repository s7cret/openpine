//@version=5
strategy("Partial exits",default_qty_type=strategy.fixed,default_qty_value=10,initial_capital=1000,commission_type=strategy.commission.percent,commission_value=1)
part=input.int(5,title="First take",minval=1,maxval=9)
if bar_index%4==0
    strategy.entry("L",strategy.long)
    strategy.exit("A","L",stop=95,limit=110,qty=part)
    strategy.exit("B","L",stop=95,limit=120,qty_percent=100)
plot(strategy.position_size,title="Position")
plot(strategy.equity,title="Equity")
