//@version=6
strategy("Object strategy",initial_capital=1000,default_qty_type=strategy.fixed,default_qty_value=2,commission_type=strategy.commission.percent,commission_value=1)
type TradeState
    float units=2.
    bool entered=false
method size(TradeState self)=>self.units
var state=TradeState.new()
if bar_index==0
    state.entered:=true
    strategy.entry("L",strategy.long,qty=state.size())
if bar_index==3 and state.entered
    strategy.close("L")
plot(strategy.equity)
