//@version=5
strategy("Semantic strategy",initial_capital=1000,default_qty_type=strategy.fixed,default_qty_value=2,commission_type=strategy.commission.percent,commission_value=1)
size(qty=2) => qty
switch bar_index
    0 => strategy.entry("L",strategy.long,qty=size())
    3 => strategy.close("L")
plot(strategy.equity)
