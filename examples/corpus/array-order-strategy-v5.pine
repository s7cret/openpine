//@version=5
strategy("Array ranking strategy",initial_capital=1000,default_qty_type=strategy.fixed,default_qty_value=2,commission_type=strategy.commission.percent,commission_value=1)
priority=array.from(3,1)
units=array.from(1.,2.)
indices=priority.sort_indices()
qty=units.get(indices.get(0))
if bar_index==0
    strategy.entry("L",strategy.long,qty=qty)
if bar_index==3
    strategy.close("L")
plot(strategy.equity)
