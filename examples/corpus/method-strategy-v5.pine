//@version=5
strategy("Method strategy",initial_capital=1000,default_qty_type=strategy.fixed,default_qty_value=2,commission_type=strategy.commission.percent,commission_value=1)
method size(int qty)=>qty
method size(float qty)=>qty
if bar_index==0
    strategy.entry("L",strategy.long,qty=(2).size())
if bar_index==3
    strategy.close("L")
plot(strategy.equity)
