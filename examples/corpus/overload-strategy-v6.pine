//@version=6
strategy("Overload strategy",initial_capital=1000,default_qty_type=strategy.fixed,default_qty_value=2,commission_type=strategy.commission.percent,commission_value=1)
size(int qty)=>qty
size(float qty)=>qty
if bar_index==0
    strategy.entry("L",strategy.long,qty=size(2))
if bar_index==3
    strategy.close("L")
plot(strategy.equity)
