//@version=5
strategy("Graph strategy",initial_capital=1000,default_qty_type=strategy.fixed,default_qty_value=2,commission_type=strategy.commission.percent,commission_value=1)
type Order
    float qty
    Order next
type Book
    array<Order> queue
var book=Book.new(array.new<Order>())
if bar_index==0
    order=Order.new(2.)
    order.next:=order
    book.queue.push(order)
    strategy.entry("L",strategy.long,qty=book.queue.get(0).next.qty)
if bar_index==3
    strategy.close("L")
plot(strategy.equity)
