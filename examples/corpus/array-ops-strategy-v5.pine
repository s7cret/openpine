//@version=5
strategy("Array editing strategy",initial_capital=1000,default_qty_type=strategy.fixed,default_qty_value=2,commission_type=strategy.commission.percent,commission_value=1)
type Signal
    float units=2.
var pending=array.new<Signal>()
if bar_index==0
    pending.insert(0,Signal.new())
if pending.size()>0
    signal=pending.get(0)
    if pending.includes(signal)
        removed=pending.remove(pending.indexof(signal))
        strategy.entry("L",strategy.long,qty=removed.units)
if bar_index==3
    strategy.close("L")
plot(strategy.equity)
