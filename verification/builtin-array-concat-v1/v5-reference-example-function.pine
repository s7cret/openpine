//@version=5
indicator("concat exact arrays")
var a=array.new_float(0)
var b=array.new_float(0)
var c=a
if bar_index==0
    array.push(a,0.0)
    array.push(a,1.0)
    array.push(b,2.0)
    array.push(b,3.0)
if bar_index==1
    c:=array.concat(id2=b,id1=a)
if bar_index==2
    array.push(c,4.0)
plot(array.size(c))
