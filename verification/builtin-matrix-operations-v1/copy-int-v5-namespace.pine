indicator("matrix literal")
var a=matrix.new<int>(2,2,0)
var b=matrix.new<int>(0,0,0)
if bar_index==0
    matrix.set(a,0,0,1)
    matrix.set(a,0,1,2)
    matrix.set(a,1,0,3)
    matrix.set(a,1,1,4)
if bar_index==1
    b:=matrix.copy(a)
if bar_index==2
    matrix.set(b,0,0,9)
if bar_index==3
    matrix.set(a,1,1,8)
