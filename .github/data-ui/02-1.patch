@@ -36,3 +36,20 @@ export function createLatestRequest(): LatestRequestController {
 
   return { begin, cancel }
 }
+
+
+/** Generation tokens suppress stale async writes; they do not cancel server work. */
+export function createRequestEpoch() {
+  let generation = 0
+  let disposed = false
+  const capture = () => {
+    const ticket = generation
+    return () => !disposed && ticket === generation
+  }
+  return {
+    capture,
+    begin: () => { generation += 1; return capture() },
+    invalidate: () => { generation += 1 },
+    dispose: () => { disposed = true; generation += 1 },
+  }
+}
diff --git a/openpine-ui/src/lib/terminalPolling.test.ts b/openpine-ui/src/lib/terminalPolling.test.ts
index 88a0639960624f51ec5b1397de5e26c85655ce07..8a21b7a753311598c825f5413f099c18418fdce8 100644
